{
	"name": "qrbit",
	"version": "3.1.2",
	"description": "A fast QR code generator with logo embedding support",
	"type": "module",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"main": "dist/qrbit.cjs",
	"module": "dist/qrbit.js",
	"types": "dist/qrbit.d.ts",
	"exports": {
		".": {
			"types": "./dist/qrbit.d.ts",
			"import": "./dist/qrbit.js",
			"require": "./dist/qrbit.cjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build:napi": "napi build --platform --output-dir src --no-js --dts generated-napi.d.ts",
		"build:napi:release": "napi build --platform --release --output-dir src --no-js --dts generated-napi.d.ts",
		"build:release": "pnpm build:napi:release && pnpm build:ts && pnpm build:copy",
		"build": "pnpm build:napi && pnpm build:ts && pnpm build:copy",
		"build:linux": "napi build --platform --release --output-dir src --no-js --dts generated-napi.d.ts --target x86_64-unknown-linux-gnu",
		"build:ts": "tsdown",
		"build:copy": "cp src/qrbit.*.node dist/",
		"clean": "rimraf dist src/*.node src/generated-napi.d.ts src/index.d.ts target",
		"lint": "biome check --write --error-on-warnings",
		"test": "pnpm lint && vitest run --coverage",
		"test:ci": "vitest run --coverage",
		"benchmark:common": "tsx benchmark/qrcode-common-svg.ts && tsx benchmark/qrcode-common-png.ts",
		"benchmark:svg": "tsx benchmark/qrcode-svg.ts",
		"benchmark:png": "tsx benchmark/qrcode-png.ts",
		"benchmark:jpg": "tsx benchmark/qrcode-jpg.ts",
		"benchmark:webp": "tsx benchmark/qrcode-webp.ts",
		"benchmark:logo": "tsx benchmark/qrcode-logo.ts",
		"benchmark": "pnpm build:release && pnpm benchmark:svg && pnpm benchmark:png && pnpm benchmark:jpg && pnpm benchmark:webp && pnpm benchmark:logo",
		"benchmark:readme": "pnpm build:release && pnpm tsx benchmark/update-readme.ts",
		"generate-examples": "rimraf ./examples && pnpm tsx ./scripts/generate-examples.ts",
		"artifacts": "napi artifacts",
		"version": "napi version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@emnapi/core": "^1.11.3",
		"@emnapi/runtime": "^1.11.3",
		"@faker-js/faker": "^10.6.0",
		"@loskir/styled-qr-code-node": "^2.0.0",
		"@monstermann/tinybench-pretty-printer": "^0.3.0",
		"@napi-rs/cli": "^3.8.6",
		"@types/node": "^24.13.3",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^4.1.11",
		"qrcode": "^1.5.4",
		"rimraf": "^6.1.3",
		"tinybench": "^6.1.3",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jaredwray/qrbit.git"
	},
	"keywords": [
		"qr",
		"qrcode",
		"generator",
		"svg",
		"png",
		"logo",
		"rust",
		"napi"
	],
	"author": "Jared Wray <me@jaredwray.com>",
	"license": "MIT",
	"napi": {
		"binaryName": "qrbit",
		"targets": [
			"aarch64-apple-darwin",
			"x86_64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"x86_64-pc-windows-msvc"
		]
	},
	"dependencies": {
		"cacheable": "^2.5.0",
		"hookified": "^3.0.3"
	}
}
